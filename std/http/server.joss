public class HttpServer {
    public static func start(): void {
        var $portStr = env("PORT")
        var $port = ($portStr != null && strlen($portStr) > 0) ? intval($portStr) : 80
        try {
            HttpServer::run($port)
        }  catch ($ex) {
            ($port == 80) ? {
                print("[Server] Puerto 80 no disponible o requiere permisos de administrador. Reintentando en puerto 8000...\n")
                HttpServer::run(8000)
            } : {
                throw $ex
            }
        }
    }

    public static func run(int $port): void {
        print("[Server::start] Iniciando servidor web...\n")
        print("[Joss Native Server] Escuchando en http://localhost:" . $port . "\n")

        var $smokeCheck = env("JOSS_NATIVE_CHECK_ONLY")
        ($smokeCheck != null && strlen($smokeCheck) > 0) ? {
            return
        }

        var $server = Socket::listen("0.0.0.0", "" . $port)
        guard ($server != null) : {
            return
        }

        print("[Server] Socket TCP enlazado con éxito en :" . $port . ". Servidor listo para peticiones.\n")

        while (true) {
            var $client = $server->accept()
            ($client == null) ? {
                continue
            }

            var $raw = $client->receive(4096)
            var $expectedBytes = HttpServer::expectedRequestBytes($raw)
            while ($expectedBytes < 0 || strlen($raw) < $expectedBytes) {
                var $chunk = $client->receive(4096)
                (strlen($chunk) == 0) ? {
                    break
                }
                $raw = $raw . $chunk
                $expectedBytes = HttpServer::expectedRequestBytes($raw)
            }
            (strlen($raw) == 0) ? {
                $client->close()
                continue
            }

            var $response = HttpServer::handle($raw)
            $client->send($response)
            $client->close()
        }
    }

    public static func handle(string $raw) : string {
        var $lines = explode("\r\n", $raw)
        guard (count($lines) > 0) : {
            return "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
        }

        var $reqLine = explode(" ", $lines [0])
        guard (count($reqLine) >= 2) : {
            return "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
        }

        string $_method = $reqLine [0]
        string $path = $reqLine [1]
        var $requestData = HttpRequestParser::parse($raw)
        ($_method == "POST") ? {
            var $requestBody = strval($requestData["_body"] ?? "")
            print("[HTTPTrace] POST bodyBytes=" . strlen($requestBody) . ", turnstileFieldPresent=" . Str::contains($requestBody, "cf-turnstile-response="))
        }
        var $pathParts = explode("?", $path)
        (count($pathParts) > 0) ? {
            $path = $pathParts [0]
        }

        // Parse HTTP request headers
        var $upgradeHeader = ""
        var $connectionHeader = ""
        var $secKey = ""
        var $idx = 1
        var $numLines = count($lines)
        while ($idx < $numLines) {
            var $line = $lines [$idx]
            (strlen($line) == 0) ? {
                break
            }
            var $lowerLine = strtolower($line)
            (Str::contains($lowerLine, "upgrade:")) ? {
                var $uParts = explode(":", $line)
                (count($uParts) >= 2) ? {
                    $upgradeHeader = trim($uParts [1])
                }
            }
            (Str::contains($lowerLine, "connection:")) ? {
                var $cParts = explode(":", $line)
                (count($cParts) >= 2) ? {
                    $connectionHeader = trim($cParts [1])
                }
            }
            (Str::contains($lowerLine, "sec-websocket-key:")) ? {
                var $kParts = explode(":", $line)
                (count($kParts) >= 2) ? {
                    $secKey = trim($kParts [1])
                }
            }
            $idx++
        }

        // WebSocket Upgrade detection
        guard (!WebSocketProtocol::isUpgradeRequest($upgradeHeader, $connectionHeader)) : {
            return WebSocketProtocol::handshakeResponse($secKey)
        }

        // Health endpoint for Hot-Reload probing
        guard ($path != "/__joss_health") : {
            return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nCache-Control: no-cache, no-store\r\nConnection: close\r\n\r\n" . time()
        }

        // Live script for Hot-Reload DOM diffing / morphing
        guard ($path != "/__joss_live.js") : {
            return "HTTP/1.1 200 OK\r\nContent-Type: application/javascript; charset=utf-8\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n" . HotReload::liveJs()
        }

        print("[Server REQ] \n" . $path . "\n\n[Server ROUTE] Dispatching: \n" . $path . "\n")

        // 1. Static assets embedded directly in the standalone executable binary (.rodata)
        var $embedded = __joss_get_embedded_asset($path)
        guard ($embedded == "" || $embedded == null) : {
            var $mime = Mime::fromPath($path)
            return "HTTP/1.1 200 OK\r\nContent-Type: " . $mime . "\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n" . $embedded
        }

        // 2. Dynamic disk-backed assets (relative project paths: ./, subfolders like ./pruebitas, dynamic uploads)
        var $isStatic = Str::contains($path, "/public/") || Str::contains($path, "/assets/") || Str::contains($path, "/css/") || Str::contains($path, "/images/") || Str::contains($path, "/favicon") || Str::contains($path, ".")
        var $foundStatic = false
        var $staticContent = ""
        var $staticMime = ""
        ($isStatic) ? {
            var $filePath = trim($path, "/")
            (file_exists($filePath)) ? {
                $foundStatic = true
                $staticContent = file_get_contents($filePath)
                $staticMime = Mime::fromPath($filePath)
            } : {
                var $prefixed = "public/" . $filePath
                (file_exists($prefixed)) ? {
                    $foundStatic = true
                    $staticContent = file_get_contents($prefixed)
                    $staticMime = Mime::fromPath($prefixed)
                }
            }
        }
        guard (!$foundStatic) : {
            return "HTTP/1.1 200 OK\r\nContent-Type: " . $staticMime . "\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n" . $staticContent
        }

        // Keep request session state in the canonical Joss Session store.
        var $headers = $requestData["_headers"] ?? {}
        string $cookieHeader = strval($headers["cookie"] ?? "")
        var $webSession = Session::start($cookieHeader)

        // Application Controller Routing via __joss_http_dispatch
        var $dispatched = __joss_http_dispatch($_method, $path, $requestData, $webSession->data, $webSession->getCookieHeader())
        guard ($dispatched == "" || $dispatched == null) : {
            $webSession->save()
            var $response = (Str::contains($dispatched, "HTTP/1.1")) ? $dispatched : ("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\n\r\n" . $dispatched)
            return $response
        }

        return ErrorPages::render404($path)
    }

    public static func expectedRequestBytes(string $raw): int {
        mixed $separator = strpos($raw, "\r\n\r\n")
        guard ($separator !== false) : {
            return -1
        }
        int $headerEnd = intval($separator)
        string $headers = substr($raw, 0, $headerEnd)
        int $expected = $headerEnd + 4
        foreach (explode("\r\n", $headers) as $line) {
            string $normalized = strtolower(trim($line))
            Str::startsWith($normalized, "content-length:") ? {
                var $parts = explode(":", $line)
                (count($parts) > 1) ? {
                    $expected = $headerEnd + 4 + intval(trim($parts[1]))
                }
            }
        }
        return $expected
    }

}

public class Server {
    public static func start() : void {
        HttpServer::start()
    }
}
