public class Session {
    public string $id = ""
    public map $data = {
}

public static map $globalStore = {
}

Init() {
    $this->id = ""
    $this->data = {
}
}

public static func generateId(): string {
    return UUID::generate()
}

public static func parseCookies(string $cookieHeader): map {
    var $cookies = {
}
guard (strlen($cookieHeader) > 0) : {
    return $cookies
}

var $pairs = explode(";", $cookieHeader)
foreach ($pairs as $idx => $pair) {
    var $trimmed = trim($pair)
    (strlen($trimmed) > 0) ? {
        var $eq = strpos($trimmed, "=")
        ($eq > 0) ? {
            string $name = trim(substr($trimmed, 0, $eq))
            string $val = trim(substr($trimmed, intval($eq) + 1))
            $cookies [$name] = $val
        }
    }
}
return $cookies
}

public static func start(string $cookieHeader) : Session {
    var $cookies = Session::parseCookies($cookieHeader)
    mixed $sessionCookie = $cookies ["joss_session"] ?? $cookies ["JOSS_SESSION"] ?? ""
    string $sid = strval($sessionCookie)

    var $sess = new Session()
    (strlen($sid) > 0) ? {
        $sess->id = $sid
        $sess->data = __joss_session_load($sid)
    } : {
        string $newId = Session::generateId()
        $sess->id = $newId
        $sess->data = {
    }
}

(!isset($sess->data ["csrf_token"])) ? {
    string $csrfToken = UUID::generate()
    $sess->data ["csrf_token"] = $csrfToken
    $sess->data ["_token"] = $csrfToken
}
__joss_session_save($sess->id, $sess->data)
return $sess
}

public func getId() : string {
    return $this->id
}

public func get(string $key, mixed $defaultValue = null) : mixed {
    return(isset($this->data [$key])) ? $this->data [$key] : $defaultValue
}

public func put(string $key, mixed $value): void {
    $this->data [$key] = $value
    __joss_session_save($this->id, $this->data)
}

public func has(string $key): bool {
    return isset($this->data [$key])
}

public func forget(string $key): void {
    (isset($this->data [$key])) ? {
        var $cleaned = {
    }
    foreach ($this->data as $k => $v) {
        ($k != $key) ? {
            $cleaned [$k] = $v
        }
    }
    $this->data = $cleaned
    __joss_session_save($this->id, $this->data)
}
}

public func flush() : void {
    $this->data = {
}
__joss_session_save($this->id, $this->data)
}

public func getCookieHeader() : string {
    string $hdr = "Set-Cookie: joss_session=" . $this->id . "; Path=/; HttpOnly; SameSite=Lax"
    string $appEnv = strtolower(trim(env("APP_ENV", "")))
    string $sessSec = strtolower(trim(env("SESSION_SECURE", "")))
    ($appEnv == "production" || $sessSec == "true") ? {
        $hdr = $hdr . "; Secure"
    }
    return $hdr
}

public func destroy() : void {
    $this->data = {
}
__joss_session_destroy($this->id)
}

public func save(): void {
    __joss_session_save($this->id, $this->data)
}
}
