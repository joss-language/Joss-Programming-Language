public class HttpRequestParser {
    public static func parse(string $raw): map {
        var $request = {
        "_headers" : {
        },
        "_cookies" : {
        },
        "_method": "",
        "_host": "",
        "_scheme": "http",
        "_referer": "",
        "_token": "",
        "_path": "/",
        "_query": ""
    }

    mixed $headerEnd = strpos($raw, "\r\n\r\n")
    guard ($headerEnd !== false) : {
        $request ["_error"] = "malformed_request"
        return $request
    }

    int $headerEndIndex = intval($headerEnd)
    string $head = substr($raw, 0, $headerEndIndex)
    string $body = substr($raw, $headerEndIndex + 4)
    $request ["_body"] = $body
    var $lines = explode("\r\n", $head)
    guard (count($lines) > 0) : {
        $request ["_error"] = "missing_request_line"
        return $request
    }

    var $parts = explode(" ", trim($lines [0]))
    guard (count($parts) >= 2) : {
        $request ["_error"] = "malformed_request_line"
        return $request
    }

    $request ["_method"] = strtoupper(trim($parts [0]))
    string $target = trim($parts [1])
    mixed $queryStart = strpos($target, "?")
    ($queryStart !== false) ? {
        int $queryStartIndex = intval($queryStart)
        $request ["_path"] = substr($target, 0, $queryStartIndex)
        $request ["_query"] = substr($target, $queryStartIndex + 1)
    } : {
        $request ["_path"] = $target
    }

    var $headers = {
}

var $cookies = {
}
int $lineIndex = 1
while ($lineIndex < count($lines)) {
    string $line = trim($lines [$lineIndex])
    mixed $colon = strpos($line, ":")
    ($colon !== false && intval($colon) > 0) ? {
        int $colonIndex = intval($colon)
        string $name = strtolower(trim(substr($line, 0, $colonIndex)))
        string $value = trim(substr($line, $colonIndex + 1))
        $headers [$name] = $value
        ($name == "host") ? {
            $request ["_host"] = $value
        }
        ($name == "referer") ? {
            $request ["_referer"] = $value
        }
        ($name == "cookie") ? {
            var $cookiePairs = explode(";", $value)
            foreach ($cookiePairs as $cookiePair) {
                mixed $equals = strpos($cookiePair, "=")
                ($equals !== false && intval($equals) > 0) ? {
                    int $equalsIndex = intval($equals)
                    string $cookieName = trim(substr($cookiePair, 0, $equalsIndex))
                    string $cookieValue = trim(substr($cookiePair, $equalsIndex + 1))
                    $cookies [$cookieName] = $cookieValue
                }
            }
        }
    }
    $lineIndex++
}

$request ["_headers"] = $headers
$request ["_cookies"] = $cookies

var $queryPairs = explode("&", $request ["_query"])
foreach ($queryPairs as $queryPair) {
    mixed $equals = strpos($queryPair, "=")
    ($equals !== false) ? {
        int $equalsIndex = intval($equals)
        string $key = urldecode(substr($queryPair, 0, $equalsIndex))
        string $value = urldecode(substr($queryPair, $equalsIndex + 1))
        (strlen($key) > 0) ? {
            $request [$key] = $value
        }
    }
}

string $contentType = strtolower($headers ["content-type"] ?? "")
(str_contains($contentType, "application/json")) ? {
    var $jsonPayload = json_decode($body)
    (is_array($jsonPayload)) ? {
        foreach ($jsonPayload as $key => $value) {
            $request [strval($key)] = $value
        }
    }
}

(str_contains($contentType, "application/x-www-form-urlencoded")) ? {
    var $formPairs = explode("&", $body)
    foreach ($formPairs as $formPair) {
        mixed $equals = strpos($formPair, "=")
        ($equals !== false) ? {
            int $equalsIndex = intval($equals)
            string $key = urldecode(substr($formPair, 0, $equalsIndex))
            string $value = urldecode(substr($formPair, $equalsIndex + 1))
            (strlen($key) > 0) ? {
                $request [$key] = $value
            }
        }
    }
}

return $request
}
}

// Request facade policy lives in Joss. Request::input is the narrow runtime
// primitive that exposes the current request map; all derived accessors share
// these rules in the interpreter, JIT, and AOT.
public func __joss_host_Request_root() : string {
    mixed $missing = "__JOSS_REQUEST_CONTEXT_MISSING__"
    mixed $hostValue = Request::input("_host", $missing)
    ($hostValue == $missing) ? {
        return ""
    }
    string $scheme = strval(Request::input("_scheme", "http"))
    string $host = strval($hostValue)
    return $scheme . "://" . $host
}

public func __joss_host_Request_cookie(string $key, mixed $defaultValue = "") : mixed {
    map $cookies = Request::input("_cookies", {
})
return $cookies [$key] ?? $defaultValue
}

public func __joss_host_Request_header(string $key) : string {
    mixed $value = Request::input($key, null)
    ($value !== null) ? {
        return strval($value)
    }
    map $headers = Request::input("_headers", {
})
string $normalized = strtolower($key)
mixed $normalizedValue = $headers [$normalized] ?? null
($normalizedValue !== null) ? {
    return strval($normalizedValue)
}
foreach ($headers as $headerName => $headerValue) {
    (strtolower(strval($headerName)) == $normalized) ? {
        return strval($headerValue)
    }
}
return ""
}

public func __joss_host_Request_method() : string {
    mixed $missing = "__JOSS_REQUEST_CONTEXT_MISSING__"
    mixed $method = Request::input("_method", $missing)
    return($method == $missing) ? "GET" : strval($method)
}

public func __joss_host_Request_isMethod(string $expected) : bool {
    mixed $missing = "__JOSS_REQUEST_CONTEXT_MISSING__"
    mixed $method = Request::input("_method", $missing)
    return $method != $missing && strval($method) == $expected
}

public func __joss_host_Request_ismethod(string $expected) : bool {
    return __joss_host_Request_isMethod($expected)
}

public func __joss_host_Request_path() : string {
    mixed $missing = "__JOSS_REQUEST_CONTEXT_MISSING__"
    mixed $path = Request::input("_path", $missing)
    ($path == $missing) ? {
        return "/"
    }
    (strval($path) != "") ? {
        return strval($path)
    }
    mixed $url = Request::input("_url", "")
    (strval($url) != "") ? {
        return strval($url)
    }
    mixed $uri = Request::input("_uri", "")
    return(strval($uri) != "") ? strval($uri) : "/"
}

public func __joss_host_Request_url() : string {
    return __joss_host_Request_path()
}

public func __joss_host_Request_uri() : string {
    mixed $uri = Request::input("_uri", "")
    (strval($uri) != "") ? {
        return strval($uri)
    }
    return __joss_host_Request_path()
}

public func __joss_host_Request_ip() : string {
    return strval(Request::input("_ip", "127.0.0.1"))
}

public func __joss_host_Request_userAgent() : string {
    return Request::header("User-Agent")
}

public func __joss_host_Request_useragent() : string {
    return Request::userAgent()
}

public func __joss_host_Request_bearerToken() : string {
    mixed $header = Request::header("Authorization")
    string $value = strval($header ?? "")
    return(str_starts_with($value, "Bearer ")) ? substr($value, 7) : ((str_starts_with($value, "bearer ")) ? substr($value, 7) : "")
}

public func __joss_host_Request_bearertoken() : string {
    return Request::bearerToken()
}

public func __joss_host_Request_has(string $key) : bool {
    mixed $value = Request::input($key, null)
    return $value !== null && $value != ""
}

public func __joss_host_Request_file(string $key) : mixed {
    map $files = Request::input("_files", {
})
return $files [$key] ?? null
}

public func __joss_host_Request_hasFile(string $key) : bool {
    return Request::file($key) !== null
}

public func __joss_host_Request_hasfile(string $key) : bool {
    return Request::hasFile($key)
}

public func __joss_host_Request_isInternalField(string $key) : bool {
    return $key == "_headers" || $key == "_host" || $key == "_scheme" || $key == "_files" || $key == "_cookies" || $key == "_method" || $key == "_referer" || $key == "_token"
}

public func __joss_host_Request_all() : map {
    map $fields = Request::input("__joss_request_all_fields", {
})
map $result = {
}
foreach ($fields as $key => $value) {
    (__joss_host_Request_isInternalField(strval($key)) == false) ? {
        $result [$key] = $value
    }
}
return $result
}

public func __joss_host_Request_except(mixed $excludedKeys) : map {
    map $fields = Request::all()
    map $excluded = {
}
foreach ($excludedKeys as $key) {
    $excluded [strval($key)] = true
}
map $result = {
}
foreach ($fields as $key => $value) {
    ($excluded [strval($key)] ?? false) ? {
        continue
    }
    $result [$key] = $value
}
return $result
}
