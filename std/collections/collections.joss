public class Stack {
    private array<mixed> $items = []

    public func push(mixed $item): void {
        $this->items = array_push($this->items, $item)
    }

    public func pop(): mixed {
        var $n = count($this->items)
        ($n == 0) ? {
            return null
        } : {
        }
        var $last = $this->items [$n - 1]
        array<mixed> $next = []
        var $i = 0
        while ($i < ($n - 1)) {
            $next = array_push($next, $this->items [$i])
            $i = $i + 1
        }
        $this->items = $next
        return $last
    }

    public func peek(): mixed {
        var $n = count($this->items)
        ($n == 0) ? {
            return null
        } : {
        }
        return $this->items [$n - 1]
    }

    public func size(): int {
        return count($this->items)
    }

    public func isEmpty(): bool {
        return count($this->items) == 0
    }
}

public class Queue {
    private array<mixed> $items = []

    public func enqueue(mixed $item): void {
        $this->items = array_push($this->items, $item)
    }

    public func dequeue(): mixed {
        var $n = count($this->items)
        ($n == 0) ? {
            return null
        } : {
        }
        var $first = $this->items [0]
        array<mixed> $next = []
        var $i = 1
        while ($i < $n) {
            $next = array_push($next, $this->items [$i])
            $i = $i + 1
        }
        $this->items = $next
        return $first
    }

    public func peek(): mixed {
        var $n = count($this->items)
        ($n == 0) ? {
            return null
        } : {
        }
        return $this->items [0]
    }

    public func size(): int {
        return count($this->items)
    }

    public func isEmpty(): bool {
        return count($this->items) == 0
    }
}
