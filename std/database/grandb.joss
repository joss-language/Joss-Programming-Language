public class GranDB {
    public string $tableName = ""
    public string $selectCols = "*"
    public array $wheres = []
    public array $bindings = []
    public array $orders = []
    public array $joins = []
    public array $groups = []
    public array $havings = []
    public int $limitVal = - 1
    public int $offsetVal = - 1
    public bool $distinctVal = false

    Init() {
        $this->tableName = ""
        $this->selectCols = "*"
        $this->wheres = []
        $this->bindings = []
        $this->orders = []
        $this->joins = []
        $this->groups = []
        $this->havings = []
        $this->limitVal = - 1
        $this->offsetVal = - 1
        $this->distinctVal = false
    }

    private func trimSQLWhitespace(string $value): string {
        int $start = 0
        int $end = strlen($value)
        while ($start < $end) {
            string $character = substr($value, $start, 1)
            ($character == " " || $character == "\t" || $character == "\n" || $character == "\r") ? {
                $start++
            } : {
                break
            }
        }
        while ($end > $start) {
            string $character = substr($value, $end - 1, 1)
            ($character == " " || $character == "\t" || $character == "\n" || $character == "\r") ? {
                $end--
            } : {
                break
            }
        }
        return substr($value, $start, $end - $start)
    }

    private func assertIdentifier(string $name, bool $allowWildcard = false): string {
        string $normalized = $this->trimSQLWhitespace($name)
        ($allowWildcard && $normalized == "*") ? {
            return "*"
        }
        var $parts = explode(".", $normalized)
        (count($parts) == 0) ? {
            throw "GranDB Error: identificador SQL inválido"
        }
        foreach ($parts as $part) {
            (strlen($part) == 0) ? {
                throw "GranDB Error: identificador SQL inválido"
            }
            ($allowWildcard && $part == "*") ? {
                continue
            }
            int $index = 0
            while ($index < strlen($part)) {
                string $character = substr($part, $index, 1)
                bool $valid = strpos("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_", $character) !== false
                ($index > 0) ? {
                    $valid = $valid || strpos("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789$", $character) !== false
                }
                (!$valid) ? {
                    throw "GranDB Error: identificador SQL inválido"
                }
                $index++
            }
        }
        return $normalized
    }

    private func assertComparisonOperator(string $operator) : string {
        string $normalized = strtoupper($this->trimSQLWhitespace($operator))
        ($normalized == "=" || $normalized == "!=" || $normalized == "<>" || $normalized == "<" || $normalized == "<=" || $normalized == ">" || $normalized == ">=" || $normalized == "LIKE" || $normalized == "NOT LIKE" || $normalized == "IS" || $normalized == "IS NOT") ? {
            return $normalized
        }
        throw "GranDB Error: operador SQL inválido"
    }

    private func assertSelectItem(string $item) : string {
        string $normalized = $this->trimSQLWhitespace($item)
        string $expr = $normalized
        string $alias = ""
        mixed $asPos = strpos(strtolower($normalized), " as ")
        ($asPos !== false) ? {
            int $pos = intval($asPos)
            $expr = $this->trimSQLWhitespace(substr($normalized, 0, $pos))
            $alias = $this->assertIdentifier(substr($normalized, $pos + 4), false)
        }
        string $safeExpr = ""
        ($expr == "*") ? {
            $safeExpr = "*"
        } : {
            bool $matchedFunc = false
            var $functions = ["COUNT(", "SUM(", "AVG(", "MIN(", "MAX("]
            foreach ($functions as $allowedFunction) {
                int $prefixLength = strlen($allowedFunction)
                (strtolower(substr($expr, 0, $prefixLength)) == strtolower($allowedFunction) && substr($expr, - 1) == ")") ? {
                    string $argument = substr($expr, $prefixLength, strlen($expr) - $prefixLength - 1)
                    $this->assertIdentifier($argument, true)
                    $safeExpr = $expr
                    $matchedFunc = true
                }
            }
            (!$matchedFunc) ? {
                $safeExpr = $this->assertIdentifier($expr, true)
            }
        }
        ($alias != "") ? {
            return $safeExpr . " AS " . $alias
        }
        return $safeExpr
    }

    private func assertSelectList(string $columns) : string {
        var $items = explode(",", $columns)
        array<string> $safeItems = []
        foreach ($items as $item) {
            $safeItems [] = $this->assertSelectItem(strval($item))
        }
        (count($safeItems) == 0) ? {
            throw "GranDB Error: lista SELECT vacía"
        }
        return implode(", ", $safeItems)
    }

    private func renderWhere() : string {
        int $whereCount = count($this->wheres)
        ($whereCount == 0) ? {
            return ""
        }
        string $sql = " WHERE "
        int $index = 0
        while ($index < $whereCount) {
            map $where = $this->wheres [$index]
            string $boolean = strtoupper(strval($where ["boolean"]))
            ($boolean != "AND" && $boolean != "OR") ? {
                throw "GranDB Error: conector SQL inválido"
            }
            ($index > 0) ? {
                $sql = $sql . " " . $boolean . " "
            }
            string $column = $this->assertIdentifier(strval($where ["col"]))
            bool $rawOperator = array_key_exists("raw_op", $where) && $where ["raw_op"]
            ($rawOperator) ? {
                string $operator = strval($where ["op"])
                (($operator == "IS NULL" || $operator == "IS NOT NULL" || $operator == "BETWEEN ? AND ?" || $operator == "NOT BETWEEN ? AND ?")) ? {
                    $sql = $sql . $column . " " . $operator
                } : {
                    bool $validIn = str_starts_with($operator, "IN (") || str_starts_with($operator, "NOT IN (")
                    (!$validIn || substr($operator, - 1) != ")") ? {
                        throw "GranDB Error: operador SQL interno inválido"
                    }
                    string $placeholders = str_starts_with($operator, "NOT IN (") ? substr($operator, 8, strlen($operator) - 9) : substr($operator, 4, strlen($operator) - 5)
                    (strlen($placeholders) == 0) ? {
                        throw "GranDB Error: lista IN vacía"
                    }
                    int $p = 0
                    while ($p < strlen($placeholders)) {
                        string $char = substr($placeholders, $p, 1)
                        ($char != "?" && $char != "," && $char != " ") ? {
                            throw "GranDB Error: operador SQL interno inválido"
                        }
                        $p++
                    }
                    $sql = $sql . $column . " " . $operator
                }
            } : {
                string $operator = $this->assertComparisonOperator(strval($where ["op"]))
                $sql = $sql . $column . " " . $operator . " ?"
            }
            $index++
        }
        return $sql
    }

    public func setTable(string $name) : GranDB {
        $this->tableName = $this->assertIdentifier($name)
        $this->selectCols = "*"
        $this->wheres = []
        $this->bindings = []
        $this->orders = []
        $this->joins = []
        $this->groups = []
        $this->havings = []
        $this->limitVal = - 1
        $this->offsetVal = - 1
        $this->distinctVal = false
        return $this
    }

    public static func table(string $name) : GranDB {
        var $q = new GranDB()
        $q->tableName = $q->assertIdentifier($name)
        return $q
    }

    public static func from(string $name) : GranDB {
        return self::table($name)
    }

    public static func transaction(mixed $callback) : mixed {
        __joss_db_execute("BEGIN", [])
        try {
            var $db = new GranDB()
            var $res = $callback($db)
            __joss_db_execute("COMMIT", [])
            return $res
        }  catch ($e) {
            __joss_db_execute("ROLLBACK", [])
            throw $e
        }
    }

    private func selectString(string $cols) : GranDB {
        $this->selectCols = $this->assertSelectList($cols)
        return $this
    }

    private func selectArray(array<string> $cols) : GranDB {
        array<string> $parts = []
        foreach ($cols as $column) {
            $parts [] = $this->assertSelectList($column)
        }
        $this->selectCols = implode(", ", $parts)
        return $this
    }

    public func select(mixed $cols) : GranDB {
        (is_array($cols)) ? {
            return $this->selectArray($cols)
        } : {
            return $this->selectString(strval($cols))
        }
    }

    public func distinct() : GranDB {
        $this->distinctVal = true
        return $this
    }

    public func join(string $table, string $first, string $op = "=", string $second = "") : GranDB {
        var $actualOp = ($second == "") ? "=" : $op
        var $actualSec = ($second == "") ? $op : $second
        $this->joins [] = ["type" => "INNER", "table" => $this->assertIdentifier($table), "first" => $this->assertIdentifier($first), "op" => $this->assertComparisonOperator($actualOp), "second" => $this->assertIdentifier($actualSec)]
        return $this
    }

    public func innerJoin(string $table, string $first, string $op = "=", string $second = "") : GranDB {
        return $this->join($table, $first, $op, $second)
    }

    public func leftJoin(string $table, string $first, string $op = "=", string $second = "") : GranDB {
        var $actualOp = ($second == "") ? "=" : $op
        var $actualSec = ($second == "") ? $op : $second
        $this->joins [] = ["type" => "LEFT", "table" => $this->assertIdentifier($table), "first" => $this->assertIdentifier($first), "op" => $this->assertComparisonOperator($actualOp), "second" => $this->assertIdentifier($actualSec)]
        return $this
    }

    public func rightJoin(string $table, string $first, string $op = "=", string $second = "") : GranDB {
        var $actualOp = ($second == "") ? "=" : $op
        var $actualSec = ($second == "") ? $op : $second
        $this->joins [] = ["type" => "RIGHT", "table" => $this->assertIdentifier($table), "first" => $this->assertIdentifier($first), "op" => $this->assertComparisonOperator($actualOp), "second" => $this->assertIdentifier($actualSec)]
        return $this
    }

    public func crossJoin(string $table) : GranDB {
        $this->joins [] = ["type" => "CROSS", "table" => $this->assertIdentifier($table), "first" => "", "op" => "", "second" => ""]
        return $this
    }

    public func where(mixed $colOrClosure, mixed $opOrVal = null, mixed $val = null) : GranDB {
        (!is_string($colOrClosure)) ? {
            var $nested = new GranDB()
            $colOrClosure($nested)
            var $nestedCount = count($nested->wheres)
            ($nestedCount > 0) ? {
                var $m = 0
                while ($m < $nestedCount) {
                    var $nw = $nested->wheres [$m]
                    $this->wheres [] = $nw
                    $m++
                }
                var $nestedBindCount = count($nested->bindings)
                var $bIdx = 0
                while ($bIdx < $nestedBindCount) {
                    $this->bindings [] = $nested->bindings [$bIdx]
                    $bIdx++
                }
            }
        } : {
            var $op = ($val !== null) ? strval($opOrVal) : "="
            mixed $value = ($val !== null) ? $val : $opOrVal
            $this->wheres [] = ["col" => $this->assertIdentifier(strval($colOrClosure)), "op" => $this->assertComparisonOperator($op), "val" => $value, "boolean" => "AND", "raw_op" => false]
            $this->bindings [] = $value
        }
        return $this
    }

    public func orWhere(mixed $colOrClosure, mixed $opOrVal = null, mixed $val = null) : GranDB {
        (!is_string($colOrClosure)) ? {
            var $nested = new GranDB()
            $colOrClosure($nested)
            var $nestedCount = count($nested->wheres)
            ($nestedCount > 0) ? {
                var $m = 0
                while ($m < $nestedCount) {
                    var $nw = $nested->wheres [$m]
                    $nw ["boolean"] = "OR"
                    $this->wheres [] = $nw
                    $m++
                }
                var $nestedBindCount = count($nested->bindings)
                var $bIdx = 0
                while ($bIdx < $nestedBindCount) {
                    $this->bindings [] = $nested->bindings [$bIdx]
                    $bIdx++
                }
            }
        } : {
            var $op = ($val !== null) ? strval($opOrVal) : "="
            mixed $value = ($val !== null) ? $val : $opOrVal
            $this->wheres [] = ["col" => $this->assertIdentifier(strval($colOrClosure)), "op" => $this->assertComparisonOperator($op), "val" => $value, "boolean" => "OR", "raw_op" => false]
            $this->bindings [] = $value
        }
        return $this
    }

    public func whereLike(string $col, string $val) : GranDB {
        var $pattern = (strpos($val, "%") !== false) ? $val : ("%" . $val . "%")
        return $this->where($col, "LIKE", $pattern)
    }

    public func orWhereLike(string $col, string $val): GranDB {
        var $pattern = (strpos($val, "%") !== false) ? $val : ("%" . $val . "%")
        return $this->orWhere($col, "LIKE", $pattern)
    }

    public func whereIn(string $col, array $values): GranDB {
        array<string> $placeholders = []
        var $len = count($values)
        var $i = 0
        while ($i < $len) {
            $placeholders [] = "?"
            $this->bindings [] = $values [$i]
            $i++
        }
        var $inClause = "IN (" . implode(", ", $placeholders) . ")"
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => $inClause, "val" => null, "boolean" => "AND", "raw_op" => true]
        return $this
    }

    public func whereNotIn(string $col, array $values): GranDB {
        array<string> $placeholders = []
        var $len = count($values)
        var $i = 0
        while ($i < $len) {
            $placeholders [] = "?"
            $this->bindings [] = $values [$i]
            $i++
        }
        var $inClause = "NOT IN (" . implode(", ", $placeholders) . ")"
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => $inClause, "val" => null, "boolean" => "AND", "raw_op" => true]
        return $this
    }

    public func whereNull(string $col): GranDB {
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => "IS NULL", "val" => null, "boolean" => "AND", "raw_op" => true]
        return $this
    }

    public func whereNotNull(string $col): GranDB {
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => "IS NOT NULL", "val" => null, "boolean" => "AND", "raw_op" => true]
        return $this
    }

    public func whereBetween(string $col, mixed $min, mixed $max): GranDB {
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => "BETWEEN ? AND ?", "val" => null, "boolean" => "AND", "raw_op" => true]
        $this->bindings [] = $min
        $this->bindings [] = $max
        return $this
    }

    public func whereNotBetween(string $col, mixed $min, mixed $max): GranDB {
        $this->wheres [] = ["col" => $this->assertIdentifier($col), "op" => "NOT BETWEEN ? AND ?", "val" => null, "boolean" => "AND", "raw_op" => true]
        $this->bindings [] = $min
        $this->bindings [] = $max
        return $this
    }

    public func orderBy(string $col, string $dir = "asc"): GranDB {
        var $normalizedDir = ($dir == "desc" || $dir == "DESC") ? "DESC" : "ASC"
        $this->orders [] = ["col" => $this->assertIdentifier($col), "dir" => $normalizedDir]
        return $this
    }

    public func orderByDesc(string $col): GranDB {
        return $this->orderBy($col, "desc")
    }

    public func latest(string $col = "created_at"): GranDB {
        return $this->orderBy($col, "desc")
    }

    public func oldest(string $col = "created_at"): GranDB {
        return $this->orderBy($col, "asc")
    }

    public func limit(int $n): GranDB {
        $this->limitVal = $n
        return $this
    }

    public func take(int $n): GranDB {
        return $this->limit($n)
    }

    public func offset(int $n): GranDB {
        $this->offsetVal = $n
        return $this
    }

    public func skip(int $n): GranDB {
        return $this->offset($n)
    }

    public func forPage(int $page, int $perPage): GranDB {
        var $curr = ($page < 1) ? 1 : $page
        $this->offset(($curr - 1) * $perPage)
        $this->limit($perPage)
        return $this
    }

    public func orderByAsc(string $col): GranDB {
        return $this->orderBy($col, "asc")
    }

    public func reorder(): GranDB {
        $this->orders = []
        return $this
    }

    public func when(mixed $condition, mixed $callback, mixed $defaultCallback = null): GranDB {
        ($condition) ? {
            $callback($this, $condition)
        } : {
            ($defaultCallback !== null) ? {
                $defaultCallback($this, $condition)
            }
        }
        return $this
    }

    public func unless(mixed $condition, mixed $callback, mixed $defaultCallback = null) : GranDB {
        (!$condition) ? {
            $callback($this, $condition)
        } : {
            ($defaultCallback !== null) ? {
                $defaultCallback($this, $condition)
            }
        }
        return $this
    }

    public func toSql() : string {
        ($this->tableName == "") ? {
            return ""
        }
        var $driver = env("DB", env("DB_CONNECTION", "mysql"))
        var $prefix = env("PREFIX", env("DB_PREFIX", ""))
        var $fullTable = $this->assertIdentifier($prefix . $this->tableName)

        var $sql = ($this->distinctVal) ? "SELECT DISTINCT " : "SELECT "
        $sql = $sql . $this->assertSelectList($this->selectCols) . " FROM " . $fullTable

        var $joinCount = count($this->joins)
        ($joinCount > 0) ? {
            var $k = 0
            while ($k < $joinCount) {
                var $j = $this->joins [$k]
                string $joinType = strtoupper(strval($j ["type"]))
                ($joinType != "INNER" && $joinType != "LEFT" && $joinType != "RIGHT" && $joinType != "CROSS") ? {
                    throw "GranDB Error: tipo JOIN inválido"
                }
                ($joinType == "CROSS") ? {
                    $sql = $sql . " CROSS JOIN " . $this->assertIdentifier(strval($j ["table"]))
                } : {
                    $sql = $sql . " " . $joinType . " JOIN " . $this->assertIdentifier(strval($j ["table"])) . " ON " . $this->assertIdentifier(strval($j ["first"])) . " " . $this->assertComparisonOperator(strval($j ["op"])) . " " . $this->assertIdentifier(strval($j ["second"]))
                }
                $k++
            }
        }

        $sql = $sql . $this->renderWhere()

        var $groupCount = count($this->groups)
        ($groupCount > 0) ? {
            $sql = $sql . " GROUP BY "
            var $gIdx = 0
            while ($gIdx < $groupCount) {
                ($gIdx > 0) ? {
                    $sql = $sql . ", "
                }
                $sql = $sql . $this->assertIdentifier(strval($this->groups [$gIdx]))
                $gIdx++
            }
        }

        var $havingCount = count($this->havings)
        ($havingCount > 0) ? {
            $sql = $sql . " HAVING "
            var $hIdx = 0
            while ($hIdx < $havingCount) {
                var $h = $this->havings [$hIdx]
                ($hIdx > 0) ? {
                    $sql = $sql . " " . strval($h ["bool"]) . " "
                }
                $sql = $sql . $this->assertIdentifier(strval($h ["col"])) . " " . $this->assertComparisonOperator(strval($h ["op"])) . " ?"
                $hIdx++
            }
        }

        var $orderCount = count($this->orders)
        ($orderCount > 0) ? {
            $sql = $sql . " ORDER BY "
            var $j = 0
            while ($j < $orderCount) {
                var $o = $this->orders [$j]
                ($j > 0) ? {
                    $sql = $sql . ", "
                }
                (strval($o ["col"]) == "__RANDOM__") ? {
                    $sql = $sql . "RANDOM()"
                } : {
                    $sql = $sql . $this->assertIdentifier(strval($o ["col"])) . " " . (($o ["dir"] == "DESC") ? "DESC" : "ASC")
                }
                $j++
            }
        }

        // Paginación por motor
        ($driver == "sqlsrv" || $driver == "sqlserver") ? {
            ($this->offsetVal >= 0) ? {
                ($orderCount == 0) ? {
                    $sql = $sql . " ORDER BY (SELECT NULL)"
                }
                $sql = $sql . " OFFSET " . strval($this->offsetVal) . " ROWS"
                ($this->limitVal > 0) ? {
                    $sql = $sql . " FETCH NEXT " . strval($this->limitVal) . " ROWS ONLY"
                }
            } : {
                ($this->limitVal > 0) ? {
                    ($orderCount == 0) ? {
                        $sql = $sql . " ORDER BY (SELECT NULL)"
                    }
                    $sql = $sql . " OFFSET 0 ROWS FETCH NEXT " . strval($this->limitVal) . " ROWS ONLY"
                }
            }
        } : {
            ($this->limitVal > 0) ? {
                $sql = $sql . " LIMIT " . strval($this->limitVal)
            }
            ($this->offsetVal > 0) ? {
                $sql = $sql . " OFFSET " . strval($this->offsetVal)
            }
        }

        return $sql
    }

    private func matchesRow(map $row) : bool {
        var $wCount = count($this->wheres)
        ($wCount == 0) ? {
            return true
        }
        var $i = 0
        while ($i < $wCount) {
            var $w = $this->wheres [$i]
            var $col = strval($w ["col"])
            var $expected = strval($w ["val"])
            var $actual = strval($row [$col])
            ($actual != $expected) ? {
                return false
            }
            $i++
        }
        return true
    }

    public func count() : int {
        var $rows = $this->get()
        return count($rows)
    }

    public func avg(string $col) : mixed {
        var $clone = new GranDB()
        $clone->tableName = $this->tableName
        $clone->selectCols = "AVG(" . $col . ")"
        $clone->wheres = $this->wheres
        $clone->bindings = $this->bindings
        var $rows = __joss_db_query($clone->toSql(), $this->bindings)
        return(count($rows) > 0) ? $rows [0] ["avg"] : null
    }

    public func sum(string $col) : mixed {
        var $clone = new GranDB()
        $clone->tableName = $this->tableName
        $clone->selectCols = "SUM(" . $col . ")"
        $clone->wheres = $this->wheres
        $clone->bindings = $this->bindings
        var $rows = __joss_db_query($clone->toSql(), $this->bindings)
        return(count($rows) > 0) ? $rows [0] ["sum"] : 0
    }

    public func min(string $col) : mixed {
        var $clone = new GranDB()
        $clone->tableName = $this->tableName
        $clone->selectCols = "MIN(" . $col . ")"
        $clone->wheres = $this->wheres
        $clone->bindings = $this->bindings
        var $rows = __joss_db_query($clone->toSql(), $this->bindings)
        return(count($rows) > 0) ? $rows [0] ["min"] : null
    }

    public func max(string $col) : mixed {
        var $clone = new GranDB()
        $clone->tableName = $this->tableName
        $clone->selectCols = "MAX(" . $col . ")"
        $clone->wheres = $this->wheres
        $clone->bindings = $this->bindings
        var $rows = __joss_db_query($clone->toSql(), $this->bindings)
        return(count($rows) > 0) ? $rows [0] ["max"] : null
    }

    public func pluck(string $col) : array {
        $this->select($col)
        var $rows = $this->get()
        var $result = []
        foreach ($rows as $row) {
            (array_key_exists($col, $row)) ? {
                $result [] = $row [$col]
            }
        }
        return $result
    }

    public func first() : mixed {
        var $rows = $this->get()
        return(count($rows) > 0) ? $rows [0] : null
    }

    public func find(mixed $id) : mixed {
        $this->where("id", $id)
        return $this->first()
    }

    public func firstWhere(string $col, mixed $opOrVal, mixed $val = null) : mixed {
        $this->where($col, $opOrVal, $val)
        return $this->first()
    }

    public func exists() : bool {
        return $this->count() > 0
    }

    public func doesntExist() : bool {
        return $this->count() == 0
    }

    public func paginate(int $perPage = 15, int $page = 1) : map {
        var $total = $this->count()
        var $currPage = ($page < 1) ? 1 : $page
        var $offsetNum = ($currPage - 1) * $perPage
        $this->offset($offsetNum)
        $this->limit($perPage)

        var $data = $this->get()
        var $lastPage = ($total > 0 && $perPage > 0) ? intval(ceil(floatval($total) / floatval($perPage))) : 1

        return [
        "data" => $data,
        "total" => $total,
        "per_page" => $perPage,
        "current_page" => $currPage,
        "last_page" => $lastPage
        ]
    }

    public func get() : array {
        ($this->tableName == "") ? {
            return []
        }
        (__joss_db_is_connected()) ? {
            var $sql = $this->toSql()
            ($sql == "") ? {
                return []
            }
            return __joss_db_query($sql, $this->bindings)
        }
        var $allRows = __joss_db_get_table($this->tableName)
        var $result = []
        var $total = count($allRows)
        var $i = 0
        while ($i < $total) {
            var $row = $allRows [$i]
            ($row !== null) ? {
                var $matched = $this->matchesRow($row)
                ($matched) ? {
                    $result [] = $row
                }
            }
            $i++
        }
        return $result
    }

    public func update(map $data) : int {
        ($this->tableName == "") ? {
            return 0
        }
        (count($this->wheres) == 0) ? {
            throw "GranDB Error: update requiere filtros"
        }
        (count($data) == 0) ? {
            return 0
        }
        (__joss_db_is_connected()) ? {
            var $prefix = env("PREFIX", env("DB_PREFIX", ""))
            var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
            array<string> $setClauses = []
            array<mixed> $vals = []
            foreach ($data as $k => $v) {
                $setClauses [] = $this->assertIdentifier(strval($k)) . " = ?"
                $vals [] = $v
            }
            var $sql = "UPDATE " . $fullTable . " SET " . implode(", ", $setClauses) . $this->renderWhere()
            array<mixed> $allBindings = []
            foreach ($vals as $v) {
                $allBindings [] = $v
            }
            foreach ($this->bindings as $b) {
                $allBindings [] = $b
            }
            return intval(__joss_db_execute($sql, $allBindings))
        }
        var $rows = __joss_db_get_table($this->tableName)
        var $total = count($rows)
        var $updatedCount = 0
        var $i = 0
        while ($i < $total) {
            var $row = $rows [$i]
            ($row !== null) ? {
                var $matched = $this->matchesRow($row)
                ($matched) ? {
                    foreach ($data as $k => $v) {
                        $row [$k] = $v
                    }
                    $rows [$i] = $row
                    $updatedCount++
                }
            }
            $i++
        }
        __joss_db_set_table($this->tableName, $rows)
        return $updatedCount
    }

    public func delete() : int {
        ($this->tableName == "") ? {
            return 0
        }
        (count($this->wheres) == 0) ? {
            throw "GranDB Error: delete requiere filtros"
        }
        (__joss_db_is_connected()) ? {
            var $prefix = env("PREFIX", env("DB_PREFIX", ""))
            var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
            var $sql = "DELETE FROM " . $fullTable . $this->renderWhere()
            return intval(__joss_db_execute($sql, $this->bindings))
        }
        var $rows = __joss_db_get_table($this->tableName)
        var $total = count($rows)
        var $deletedCount = 0
        var $i = 0
        while ($i < $total) {
            var $row = $rows [$i]
            ($row !== null) ? {
                var $matched = $this->matchesRow($row)
                ($matched) ? {
                    $rows [$i] = null
                    $deletedCount++
                }
            }
            $i++
        }
        __joss_db_set_table($this->tableName, $rows)
        return $deletedCount
    }

    public func insert(map $data) : int {
        ($this->tableName == "" || count($data) == 0) ? {
            return 0
        }
        (__joss_db_is_connected()) ? {
            var $prefix = env("PREFIX", env("DB_PREFIX", ""))
            var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
            array<string> $cols = []
            array<string> $placeholders = []
            var $vals = []
            foreach ($data as $k => $v) {
                $cols [] = $this->assertIdentifier(strval($k))
                $placeholders [] = "?"
                $vals [] = $v
            }
            var $sql = "INSERT INTO " . $fullTable . " (" . implode(", ", $cols) . ") VALUES (" . implode(", ", $placeholders) . ")"
            return intval(__joss_db_execute($sql, $vals))
        }
        var $rows = __joss_db_get_table($this->tableName)
        var $newId = count($rows) + 1
        (!array_key_exists("id", $data)) ? {
            $data ["id"] = $newId
        }
        $rows [] = $data
        __joss_db_set_table($this->tableName, $rows)
        return $newId
    }

    public func insertGetId(map $data) : int {
        return $this->insert($data)
    }

    public func insertMany(array $rows) : int {
        var $total = 0
        foreach ($rows as $row) {
            $this->insert($row)
            $total++
        }
        return $total
    }

    public func increment(string $col, mixed $amount = 1) : int {
        ($this->tableName == "") ? {
            return 0
        }
        var $prefix = env("PREFIX", env("DB_PREFIX", ""))
        (count($this->wheres) == 0) ? {
            throw "GranDB Error: increment requiere filtros"
        }
        var $safeCol = $this->assertIdentifier($col)
        var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
        var $sql = "UPDATE " . $fullTable . " SET " . $safeCol . " = " . $safeCol . " + ?" . $this->renderWhere()
        var $allBindings = [$amount]
        foreach ($this->bindings as $binding) {
            $allBindings [] = $binding
        }
        return __joss_db_execute($sql, $allBindings)
    }

    public func decrement(string $col, mixed $amount = 1) : int {
        ($this->tableName == "") ? {
            return 0
        }
        var $prefix = env("PREFIX", env("DB_PREFIX", ""))
        (count($this->wheres) == 0) ? {
            throw "GranDB Error: decrement requiere filtros"
        }
        var $safeCol = $this->assertIdentifier($col)
        var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
        var $sql = "UPDATE " . $fullTable . " SET " . $safeCol . " = " . $safeCol . " - ?" . $this->renderWhere()
        var $allBindings = [$amount]
        foreach ($this->bindings as $binding) {
            $allBindings [] = $binding
        }
        return __joss_db_execute($sql, $allBindings)
    }

    public func groupBy(string $col) : GranDB {
        $this->groups [] = $this->assertIdentifier($col)
        return $this
    }

    public func having(string $col, string $op, mixed $val) : GranDB {
        $this->havings [] = {"bool" : "AND", "col" : $this->assertIdentifier($col), "op" : $this->assertComparisonOperator($op)
    }
    $this->bindings [] = $val
    return $this
}

public func orHaving(string $col, string $op, mixed $val) : GranDB {
    $this->havings [] = {"bool" : "OR", "col" : $this->assertIdentifier($col), "op" : $this->assertComparisonOperator($op)
}
$this->bindings [] = $val
return $this
}

public func whereColumn(string $first, string $op, string $second) : GranDB {
    string $expr = $this->assertIdentifier($first) . " " . $this->assertComparisonOperator($op) . " " . $this->assertIdentifier($second)
    $this->wheres [] = {"bool" : "AND", "type" : "raw", "sql" : $expr
}
return $this
}

public func whereNot(string $col, mixed $val) : GranDB {
    return $this->where($col, "!=", $val)
}

public func inRandomOrder() : GranDB {
    $this->orders [] = {"col" : "__RANDOM__", "dir" : "ASC"
}
return $this
}

public func getBindings() : array {
    return $this->bindings
}

public func value(string $col) : mixed {
    var $row = $this->first()
    ($row == null) ? {
        return null
    }
    return $row [$col] ?? null
}

public func firstOrFail() : mixed {
    var $row = $this->first()
    ($row == null) ? {
        throw "GranDB Error: registro no encontrado"
    }
    return $row
}

public func findOrFail(mixed $id) : mixed {
    var $row = $this->find($id)
    ($row == null) ? {
        throw "GranDB Error: registro no encontrado para id"
    }
    return $row
}

public func findMany(array $ids) : array {
    (count($ids) == 0) ? {
        return []
    }
    return $this->whereIn("id", $ids)->get()
}

public func sole() : mixed {
    var $rows = $this->limit(2)->get()
    int $n = count($rows)
    ($n == 0) ? {
        throw "GranDB Error: no se encontró ningún registro (sole)"
    }
    ($n > 1) ? {
        throw "GranDB Error: se encontraron múltiples registros (sole)"
    }
    return $rows [0]
}

public func updateOrInsert(map $attributes, map $values) : int {
    var $q = GranDB::table($this->tableName)
    foreach ($attributes as $k => $v) {
        $q->where(strval($k), $v)
    }
    ($q->exists()) ? {
        return $q->update($values)
    }
    map $merged = {
}
foreach ($attributes as $k => $v) {
    $merged [$k] = $v
}
foreach ($values as $k => $v) {
    $merged [$k] = $v
}
return GranDB::table($this->tableName)->insert($merged)
}

public func deleteAll() : int {
    ($this->tableName == "") ? {
        return 0
    }
    var $prefix = env("PREFIX", env("DB_PREFIX", ""))
    var $fullTable = $this->assertIdentifier($prefix . $this->tableName)
    return __joss_db_execute("DELETE FROM " . $fullTable, [])
}

public func truncate() : int {
    return $this->deleteAll()
}

public func simplePaginate(int $perPage = 15, int $page = 1) : map {
    ($page < 1) ? {
        $page = 1
    }
    ($perPage < 1) ? {
        $perPage = 15
    }
    var $rows = $this->forPage($page, $perPage + 1)->get()
    bool $hasMore = count($rows) > $perPage
    array $items = []
    int $i = 0
    while ($i < count($rows) && $i < $perPage) {
        $items [] = $rows [$i]
        $i++
    }
    return {"data" : $items, "per_page" : $perPage, "current_page" : $page, "has_more": $hasMore
}
}
}
