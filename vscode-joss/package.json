{
  "name": "joss-language",
  "displayName": "Joss Language Support",
  "description": "Joss IntelliSense with parameter hints, project indexing, navigation, diagnostics, and security analysis",
  "version": "3.8.0",
  "icon": "images/icon.png",
  "publisher": "jossecurity",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "joss",
    "jossecurity",
    "security",
    "web",
    "backend",
    "lsp",
    "remove:crud"
  ],
  "contributes": {
    "languages": [
      {
        "id": "joss",
        "aliases": [
          "Joss",
          "JosSecurity",
          "joss"
        ],
        "extensions": [
          ".joss"
        ],
        "icon": {
          "light": "./icons/joss-file.png",
          "dark": "./icons/joss-file.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "joss-html",
        "aliases": [
          "Joss HTML",
          "JosSecurity HTML",
          "joss-html"
        ],
        "extensions": [
          ".joss.html"
        ],
        "icon": {
          "light": "./icons/joss-html-file.svg",
          "dark": "./icons/joss-html-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "iconThemes": [
      {
        "id": "joss-file-icons",
        "label": "Joss File Icons",
        "path": "./icons/joss-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "joss",
        "scopeName": "source.joss",
        "path": "./syntaxes/joss.tmLanguage.json"
      },
      {
        "language": "joss-html",
        "scopeName": "text.html.joss",
        "path": "./syntaxes/joss-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.joss": "joss"
        }
      }
    ],
    "snippets": [
      {
        "language": "joss",
        "path": "./snippets/joss.json"
      }
    ],
    "themes": [
      {
        "label": "JosSecurity Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/joss-dark.json"
      }
    ],
    "commands": [
      {
        "command": "joss.indexWorkspace",
        "title": "Joss: Index Workspace"
      },
      {
        "command": "joss.goToRoute",
        "title": "Joss: Go to Route"
      },
      {
        "command": "joss.createController",
        "title": "Joss: Make Controller"
      },
      {
        "command": "joss.runSecurityCheck",
        "title": "Joss: Run Security Check"
      },
      {
        "command": "joss.openDefinition",
        "title": "Joss: Open Definition"
      },
      {
        "command": "joss.restartServer",
        "title": "Joss: Restart Language Server"
      },
      {
        "command": "joss.newProject",
        "title": "Joss: New Project"
      },
      {
        "command": "joss.makeModel",
        "title": "Joss: Make Model"
      },
      {
        "command": "joss.makeCRUD",
        "title": "Joss: Make CRUD"
      },
      {
        "command": "joss.removeCRUD",
        "title": "Joss: Remove CRUD"
      },
      {
        "command": "joss.makeMigration",
        "title": "Joss: Make Migration"
      },
      {
        "command": "joss.migrate",
        "title": "Joss: Run Migrations"
      },
      {
        "command": "joss.serverStart",
        "title": "Joss: Start Server"
      },
      {
        "command": "joss.changeDbPrefix",
        "title": "Joss: Change DB Prefix"
      },
      {
        "command": "joss.changeDbEngine",
        "title": "Joss: Change DB Engine"
      },
      {
        "command": "joss.userstorage",
        "title": "Joss: Configure User Storage"
      },
      {
        "command": "joss.makeView",
        "title": "Joss: Make View"
      },
      {
        "command": "joss.makeMVC",
        "title": "Joss: Make MVC"
      },
      {
        "command": "joss.formatDocument",
        "title": "Joss: Format Document"
      },
      {
        "command": "joss.formatWorkspace",
        "title": "Joss: Format Workspace"
      },
      {
        "command": "joss.lint",
        "title": "Joss: Run Linter"
      },
      {
        "command": "joss.fix",
        "title": "Joss: Fix Code Issues"
      },
      {
        "command": "joss.test",
        "title": "Joss: Run Tests"
      },
      {
        "command": "joss.checkSyntax",
        "title": "Joss: Check Syntax & Types"
      },
      {
        "command": "joss.buildWeb",
        "title": "Joss: Build Web Application"
      },
      {
        "command": "joss.buildNative",
        "title": "Joss: Build Native Executable"
      },
      {
        "command": "joss.migrateFresh",
        "title": "Joss: Run Fresh Migrations with Seeders"
      },
      {
        "command": "joss.dbSeed",
        "title": "Joss: Run Database Seeders"
      },
      {
        "command": "joss.makeMiddleware",
        "title": "Joss: Make Middleware"
      },
      {
        "command": "joss.pluginCompile",
        "title": "Joss: Compile Plugin (.jp)"
      },
      {
        "command": "joss.pluginValidate",
        "title": "Joss: Validate Plugin"
      },
      {
        "command": "joss.runFile",
        "title": "Joss: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "joss.buildGUI",
        "title": "Joss: Build GUI Executable",
        "icon": "$(window)"
      },
      {
        "command": "joss.programStart",
        "title": "Joss: Launch Desktop App (joss program start)"
      },
      {
        "command": "joss.emitIR",
        "title": "Joss: Inspect Native IR (emit-ir)"
      },
      {
        "command": "joss.quickActions",
        "title": "Joss: Quick Actions Menu"
      },
      {
        "command": "joss.refreshExplorer",
        "title": "Joss: Refresh Explorer",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "jossExplorer",
          "name": "Joss Project",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == joss",
          "command": "joss.runFile",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId == joss",
          "command": "joss.buildGUI",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "when": "view == jossExplorer",
          "command": "joss.refreshExplorer",
          "group": "navigation"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "joss",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The Joss CLI subcommand (e.g., build, run, test, check, lint, fix, format)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments passed to the Joss CLI"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "joss",
        "label": "Joss Native",
        "languages": [
          "joss"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array",
                "description": "Arguments passed to the Joss CLI (e.g. [\"server\", \"start\"] or [\"run\", \"main.joss\"])",
                "default": [
                  "server",
                  "start"
                ]
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the Joss command",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "joss",
            "request": "launch",
            "name": "Joss: Start Dev Server",
            "args": [
              "server",
              "start"
            ],
            "cwd": "${workspaceFolder}"
          },
          {
            "type": "joss",
            "request": "launch",
            "name": "Joss: Run Current File",
            "args": [
              "run",
              "${file}"
            ],
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "joss",
        "owner": "joss",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\[(JOSS-[A-Z0-9-]+)\\]\\s+(ERROR|WARNING|INFO)\\s+(.+?):(\\d+):(\\d+):\\s+(.+)$",
          "code": 1,
          "severity": 2,
          "file": 3,
          "line": 4,
          "column": 5,
          "message": 6
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Joss",
      "properties": {
        "joss.enableJosSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Enable security analysis"
        },
        "joss.executablePath": {
          "type": "string",
          "default": "joss",
          "description": "Path to the Joss binary"
        },
        "joss.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable formatting for Joss files"
        },
        "joss.diagnostics.compiler.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time Joss compiler and linter diagnostics (joss lint --json)"
        },
        "joss.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show inline parameter name hints and inferred var types"
        },
        "joss.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show clickable Run / Build Native / Build GUI / Run Tests CodeLens actions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fast-levenshtein": "^3.0.0",
    "level": "^8.0.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "qs": "^6.17.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "@azure/msal-node": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jossecurity/joss"
  },
  "license": "MIT"
}
