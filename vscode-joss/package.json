{
  "name": "joss-language",
  "displayName": "Joss Language Support",
  "description": "Joss IntelliSense with parameter hints, project indexing, navigation, diagnostics, and security analysis",
  "version": "3.7.0",
  "icon": "images/icon.png",
  "publisher": "jossecurity",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "joss",
    "jossecurity",
    "security",
    "web",
    "backend",
    "lsp",
    "remove:crud"
  ],
  "contributes": {
    "languages": [
      {
        "id": "joss",
        "aliases": [
          "JosSecurity",
          "joss"
        ],
        "extensions": [
          ".joss"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "joss-html",
        "aliases": [
          "JosSecurity HTML",
          "joss-html"
        ],
        "extensions": [
          ".joss.html"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "joss",
        "scopeName": "source.joss",
        "path": "./syntaxes/joss.tmLanguage.json"
      },
      {
        "language": "joss-html",
        "scopeName": "text.html.joss",
        "path": "./syntaxes/joss-html.tmLanguage.json",
        "embeddedLanguages": {
          "source.joss": "joss"
        }
      }
    ],
    "snippets": [
      {
        "language": "joss",
        "path": "./snippets/joss.json"
      }
    ],
    "themes": [
      {
        "label": "JosSecurity Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/joss-dark.json"
      }
    ],
    "commands": [
      {
        "command": "joss.indexWorkspace",
        "title": "Joss: Index Workspace"
      },
      {
        "command": "joss.goToRoute",
        "title": "Joss: Go to Route"
      },
      {
        "command": "joss.createController",
        "title": "Joss: Make Controller"
      },
      {
        "command": "joss.runSecurityCheck",
        "title": "Joss: Run Security Check"
      },
      {
        "command": "joss.openDefinition",
        "title": "Joss: Open Definition"
      },
      {
        "command": "joss.restartServer",
        "title": "Joss: Restart Language Server"
      },
      {
        "command": "joss.newProject",
        "title": "Joss: New Project"
      },
      {
        "command": "joss.makeModel",
        "title": "Joss: Make Model"
      },
      {
        "command": "joss.makeCRUD",
        "title": "Joss: Make CRUD"
      },
      {
        "command": "joss.removeCRUD",
        "title": "Joss: Remove CRUD"
      },
      {
        "command": "joss.makeMigration",
        "title": "Joss: Make Migration"
      },
      {
        "command": "joss.migrate",
        "title": "Joss: Run Migrations"
      },
      {
        "command": "joss.serverStart",
        "title": "Joss: Start Server"
      },
      {
        "command": "joss.changeDbPrefix",
        "title": "Joss: Change DB Prefix"
      },
      {
        "command": "joss.changeDbEngine",
        "title": "Joss: Change DB Engine"
      },
      {
        "command": "joss.userstorage",
        "title": "Joss: Configure User Storage"
      },
      {
        "command": "joss.makeView",
        "title": "Joss: Make View"
      },
      {
        "command": "joss.makeMVC",
        "title": "Joss: Make MVC"
      },
      {
        "command": "joss.formatDocument",
        "title": "Joss: Format Document"
      },
      {
        "command": "joss.formatWorkspace",
        "title": "Joss: Format Workspace"
      },
      {
        "command": "joss.lint",
        "title": "Joss: Run Linter"
      },
      {
        "command": "joss.fix",
        "title": "Joss: Fix Code Issues"
      },
      {
        "command": "joss.test",
        "title": "Joss: Run Tests"
      },
      {
        "command": "joss.checkSyntax",
        "title": "Joss: Check Syntax & Types"
      },
      {
        "command": "joss.buildWeb",
        "title": "Joss: Build Web Application"
      },
      {
        "command": "joss.buildNative",
        "title": "Joss: Build Native Executable"
      },
      {
        "command": "joss.migrateFresh",
        "title": "Joss: Run Fresh Migrations with Seeders"
      },
      {
        "command": "joss.dbSeed",
        "title": "Joss: Run Database Seeders"
      },
      {
        "command": "joss.makeMiddleware",
        "title": "Joss: Make Middleware"
      },
      {
        "command": "joss.pluginCompile",
        "title": "Joss: Compile Plugin (.jp)"
      },
      {
        "command": "joss.pluginValidate",
        "title": "Joss: Validate Plugin"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Joss",
      "properties": {
        "joss.enableJosSecurity": {
          "type": "boolean",
          "default": true,
          "description": "Enable security analysis"
        },
        "joss.executablePath": {
          "type": "string",
          "default": "joss",
          "description": "Path to the Joss binary"
        },
        "joss.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable formatting for Joss files"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "fast-levenshtein": "^3.0.0",
    "level": "^8.0.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-uri": "^3.0.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "qs": "6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jossecurity/joss"
  },
  "license": "MIT"
}
