{
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "\tInit ${2:main}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Create a new class with Init method"
  },
  "Controller": {
    "prefix": "controller",
    "body": [
      "class ${1:Name}Controller {",
      "\tfunc index() {",
      "\t\treturn View::render(\"${2:view}\", {\"title\": \"${3:Title}\"})",
      "\t}",
      "}"
    ],
    "description": "Create a new Controller class"
  },
  "Init Method": {
    "prefix": "init",
    "body": [
      "Init ${1:methodName}() {",
      "\t$0",
      "}"
    ],
    "description": "Create an Init method"
  },
  "Router Get": {
    "prefix": "route:get",
    "body": [
      "Router::get(\"/${1:path}\", \"${2:Controller}@${3:method}\")"
    ],
    "description": "Define a GET route"
  },
  "Router Post": {
    "prefix": "route:post",
    "body": [
      "Router::post(\"/${1:path}\", \"${2:Controller}@${3:method}\")"
    ],
    "description": "Define a POST route"
  },
  "Router Match": {
    "prefix": "route:match",
    "body": [
      "Router::match(\"${1:GET|POST}\", \"/${2:path}\", \"${3:Controller}@${4:method}\")"
    ],
    "description": "Define a multi-method route"
  },
  "Router Group": {
    "prefix": "route:group",
    "body": [
      "Router::group(\"${1:middleware}\", func() {",
      "\\t$0",
      "})"
    ],
    "description": "Define a router group"
  },
  "Router Put": {
    "prefix": "route:put",
    "body": [
      "Router::put(\"/${1:path}\", \"${2:Controller}@${3:method}\")"
    ],
    "description": "Define a PUT route"
  },
  "Router Delete": {
    "prefix": "route:delete",
    "body": [
      "Router::delete(\"/${1:path}\", \"${2:Controller}@${3:method}\")"
    ],
    "description": "Define a DELETE route"
  },
  "Router API": {
    "prefix": "route:api",
    "body": [
      "Router::api(\"/${1:path}\", \"${2:Controller}@${3:method}\")"
    ],
    "description": "Define an API route (GET & POST)"
  },
  "Redirect": {
    "prefix": "redirect",
    "body": [
      "return Redirect::to(\"${1:url}\")"
    ],
    "description": "Redirect to URL"
  },
  "Auth Check": {
    "prefix": "auth:check",
    "body": [
      "(Auth::check()) ? {",
      "\t$0",
      "} : {}"
    ],
    "description": "Check if user is authenticated"
  },
  "Auth Guest": {
    "prefix": "auth:guest",
    "body": [
      "(Auth::guest()) ? {",
      "\t$0",
      "} : {}"
    ],
    "description": "Check if user is guest"
  },
  "Auth Attempt": {
    "prefix": "auth:attempt",
    "body": [
      "(Auth::attempt($email, $password)) ? {",
      "\treturn Response::redirect(\"/dashboard\")",
      "} : {}"
    ],
    "description": "Attempt login"
  },
  "Ternary": {
    "prefix": "tern",
    "body": [
      "(${1:condition}) ? {",
      "\t${2:// true}",
      "} : {",
      "\t${3:// false}",
      "}"
    ],
    "description": "Ternary operator with blocks"
  },
  "If (Ternary)": {
    "prefix": "if",
    "body": [
      "(${1:condition}) ? {",
      "\t$0",
      "}"
    ],
    "description": "If statement (Ternary)"
  },
  "If Else (Ternary)": {
    "prefix": "ifelse",
    "body": [
      "(${1:condition}) ? {",
      "\t${2:// true}",
      "} : {",
      "\t$0",
      "}"
    ],
    "description": "If-Else statement (Ternary)"
  },
  "Else (Ternary)": {
    "prefix": "else",
    "body": [
      "} : {",
      "\t$0",
      "}"
    ],
    "description": "Else block (Ternary)"
  },
  "Switch (Ternary Ladder)": {
    "prefix": "switch",
    "body": [
      "(${1:var} == ${2:value1}) ? {",
      "\t${3:// case 1}",
      "} : (${1:var} == ${4:value2}) ? {",
      "\t${5:// case 2}",
      "} : {",
      "\t${6:// default}",
      "}"
    ],
    "description": "Switch statement (Ternary Ladder)"
  },
  "Ternary Inline": {
    "prefix": "terni",
    "body": [
      "${1:variable} = (${2:condition}) ? ${3:trueValue} : ${4:falseValue}"
    ],
    "description": "Inline ternary assignment"
  },
  "Foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (${1:array} as ${2:item}) {",
      "\t$0",
      "}"
    ],
    "description": "Foreach loop"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:\"message\"})"
    ],
    "description": "Print statement"
  },
  "Variable": {
    "prefix": "var",
    "body": [
      "${1:type} \\$${2:name} = ${3:value}"
    ],
    "description": "Declare a variable"
  },
  "Auth Create": {
    "prefix": "authcreate",
    "body": [
      "Auth::create([${1:email}, ${2:password}, ${3:name}])"
    ],
    "description": "Create user with Auth"
  },
  "GranDB Query": {
    "prefix": "dbquery",
    "body": [
      "\\$db = GranDB::table(\"${1:tableName}\")",
      "\\$result = \\$db->where(\"${2:column}\", ${3:value})->get()"
    ],
    "description": "Query database with GranDB"
  },
  "GranDB Pagination": {
    "prefix": "dbpaginate",
    "body": [
      "\\$db = GranDB::table(\"${2:tableName}\")",
      "\\$page = Request::input(\"page\")",
      "\\$perPage = ${1:10}",
      "\\$offset = (Math::abs(\\$page) - 1) * \\$perPage",
      "\\$total = \\$db->count()",
      "\\$results = \\$db->orderBy(\"id\", \"DESC\")->limit(\\$perPage)->offset(\\$offset)->get()"
    ],
    "description": "Paginate database results"
  },
  "GranDB Insert": {
    "prefix": "dbinsert",
    "body": [
      "\\$db = GranDB::table(\"${1:tableName}\")",
      "\\$db->insert([${2:columns}], [${3:values}])"
    ],
    "description": "Insert into database"
  },
  "Comment Block": {
    "prefix": "comment",
    "body": [
      "// ===== ${1:SECTION} =====",
      "$0"
    ],
    "description": "Section comment"
  },
  "Main Class": {
    "prefix": "main",
    "body": [
      "class Main {",
      "\tInit main() {",
      "\t\tprint(\"${1:Hello JosSecurity}\")",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Main class entry point"
  },
  "Async Task": {
    "prefix": "async",
    "body": [
      "\\$${1:future} = async(${2:expression})",
      "\\$${3:result} = await(\\$${1:future})"
    ],
    "description": "Create async task with await"
  },
  "Async Function": {
    "prefix": "asyncfn",
    "body": [
      "\\$${1:future} = async(${2:10 + 20})",
      "$0"
    ],
    "description": "Async function call"
  },
  "Map Literal": {
    "prefix": "map",
    "body": [
      "\\$${1:config} = {",
      "\\t\"${2:key}\": \"${3:value}\"$0",
      "}"
    ],
    "description": "Create a map literal"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\\t${1:// code}",
      "} catch (\\$${2:e}) {",
      "\\tprint(\"Error: \" + \\$${2:e})",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Class with Inheritance": {
    "prefix": "classext",
    "body": [
      "class ${1:ChildClass} extends ${2:ParentClass} {",
      "\\tInit constructor(${3:params}) {",
      "\\t\\t$0",
      "\\t}",
      "}"
    ],
    "description": "Class with inheritance"
  },
  "System Run": {
    "prefix": "sysrun",
    "body": [
      "System::Run(\"${1:command}\", [${2:args}])"
    ],
    "description": "Execute system command"
  },
  "System Env": {
    "prefix": "sysenv",
    "body": [
      "\\$${1:var} = System::env(\"${2:KEY}\")"
    ],
    "description": "Get environment variable"
  },
  "Cron Schedule": {
    "prefix": "cron",
    "body": [
      "Cron::schedule(\"${1:name}\", \"${2:00:00}\", {",
      "\\t$0",
      "})"
    ],
    "description": "Schedule a cron job"
  },
  "Task Hit": {
    "prefix": "task",
    "body": [
      "Task::on_request(\"${1:name}\", \"${2:interval}\", {",
      "\\t$0",
      "})"
    ],
    "description": "Schedule a hit-based task"
  },
  "View Render": {
    "prefix": "view",
    "body": [
      "return View::render(\"${1:viewName}\", {${2:data}})"
    ],
    "description": "Render a view"
  },
  "TOON Encode": {
    "prefix": "toonenc",
    "body": [
      "\\$toon = toon_encode(${1:data})"
    ],
    "description": "Encode to TOON"
  },
  "TOON Decode": {
    "prefix": "toondeco",
    "body": [
      "\\$data = toon_decode(${1:string})"
    ],
    "description": "Decode TOON string"
  },
  "JSON Encode": {
    "prefix": "jsonenc",
    "body": [
      "\\$json = json_encode(${1:data})"
    ],
    "description": "Encode to JSON"
  },
  "JSON Decode": {
    "prefix": "jsondeco",
    "body": [
      "\\$data = json_decode(${1:string})"
    ],
    "description": "Decode JSON string"
  },
  "Pipe Operator": {
    "prefix": "pipe",
    "body": [
      "${1:value} |> ${2:function}"
    ],
    "description": "Pipe operator - pass value to function"
  },
  "Pipe Chain": {
    "prefix": "pipechain",
    "body": [
      "${1:value} |> ${2:func1} |> ${3:func2} |> ${4:func3}"
    ],
    "description": "Chain multiple functions with pipe operator"
  },
  "Pipe with Args": {
    "prefix": "pipeargs",
    "body": [
      "${1:value} |> ${2:function}(${3:arg})"
    ],
    "description": "Pipe with additional arguments"
  },
  "Lambda Function": {
    "prefix": "lambda",
    "body": [
      "func(${1:$x}) { return ${2:$x * 2}; }"
    ],
    "description": "Anonymous lambda function"
  },
  "Pipe Lambda": {
    "prefix": "pipelambda",
    "body": [
      "${1:value} |> func(${2:$x}) { return ${3:$x}; }"
    ],
    "description": "Pipe to lambda function"
  },
  "Channel Create": {
    "prefix": "chan",
    "body": [
      "\\$${1:ch} = make_chan(${2:0})"
    ],
    "description": "Create a channel"
  },
  "Channel Send": {
    "prefix": "chansend",
    "body": [
      "\\$${1:ch} << ${2:value}"
    ],
    "description": "Send value to channel"
  },
  "Channel Receive": {
    "prefix": "chanrecv",
    "body": [
      "\\$${1:value} = recv(\\$${2:ch})"
    ],
    "description": "Receive value from channel"
  },
  "Channel Foreach": {
    "prefix": "chanfor",
    "body": [
      "foreach (\\$${1:ch} as \\$${2:value}) {",
      "\\t$0",
      "}"
    ],
    "description": "Iterate over channel values"
  },
  "Async with Channel": {
    "prefix": "asyncchan",
    "body": [
      "\\$${1:ch} = make_chan()",
      "\\$${2:future} = async({",
      "\\t\\$${1:ch} << ${3:value}",
      "})",
      "$0"
    ],
    "description": "Async task with channel communication"
  },
  "Schema Create": {
    "prefix": "schema:create",
    "body": [
      "Schema::create(\"${1:tableName}\", func(\\$table) {",
      "\t\\$table->id()",
      "\t\\$table->string(\"${2:name}\")",
      "\t\\$table->timestamps()",
      "})"
    ],
    "description": "Create a new table schema"
  },
  "Schema Drop": {
    "prefix": "schema:drop",
    "body": [
      "Schema::drop(\"${1:tableName}\")"
    ],
    "description": "Drop a table"
  },
  "Schema Drop If Exists": {
    "prefix": "schema:dropIfExists",
    "body": [
      "Schema::dropIfExists(\"${1:tableName}\")"
    ],
    "description": "Drop a table if it exists"
  },
  "Schema Table": {
    "prefix": "schema:table",
    "body": [
      "Schema::table(\"${1:tableName}\", func(\\$table) {",
      "\t\\$table->string(\"${2:column}\")",
      "\t$0",
      "})"
    ],
    "description": "Modify an existing table"
  },
  "Schema Rename": {
    "prefix": "schema:rename",
    "body": [
      "Schema::rename(\"${1:from}\", \"${2:to}\")"
    ],
    "description": "Rename a table"
  },
  "Schema Foreign Key": {
    "prefix": "schema:foreign",
    "body": [
      "\\$table->foreign(${1:\"user_id\"})",
      "\t->references(${2:\"id\"})",
      "\t->on(${3:\"users\"})",
      "\t->onDelete(${4:\"cascade\"})"
    ],
    "description": "Create a foreign key with referential actions"
  },
  "Schema Compound Index": {
    "prefix": "schema:index",
    "body": [
      "\\$table->index([${1:\"tenant_id\", \"created_at\"}], ${2:\"tenant_created_index\"})"
    ],
    "description": "Create a compound index"
  },
  "Schema Rename Column": {
    "prefix": "schema:renameColumn",
    "body": [
      "\\$table->renameColumn(\"${1:from}\", \"${2:to}\")"
    ],
    "description": "Rename a column"
  },
  "Migration Class": {
    "prefix": "migration",
    "body": [
      "class ${1:CreateUsersTable} extends Migration {",
      "\tfunc up() {",
      "\t\tSchema::create(\"${2:users}\", func(\\$table) {",
      "\t\t\t\\$table->id()",
      "\t\t\t\\$table->string(\"name\")",
      "\t\t\t\\$table->timestamps()",
      "\t\t})",
      "\t}",
      "",
      "\tfunc down() {",
      "\t\tSchema::dropIfExists(\"${2:users}\")",
      "\t}",
      "}"
    ],
    "description": "Create a full migration class"
  },
  "Keys": {
    "prefix": "keys",
    "body": [
      "keys(${1:map})"
    ],
    "description": "Get map keys"
  },
  "Values": {
    "prefix": "values",
    "body": [
      "values(${1:map})"
    ],
    "description": "Get map values"
  },
  "Env": {
    "prefix": "env",
    "body": [
      "env(\"${1:KEY}\")"
    ],
    "description": "Get environment variable"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import \"${1:path/to/file.joss}\""
    ],
    "description": "Import a file"
  },
  "Auth Validate": {
    "prefix": "auth:validate",
    "body": [
      "\\$valid = Auth::validateToken(${1:\\$token})"
    ],
    "description": "Validate a Bearer token"
  },
  "Session Get": {
    "prefix": "session:get",
    "body": [
      "Session::get(\"${1:key}\")"
    ],
    "description": "Get a value from session"
  },
  "Session Put": {
    "prefix": "session:put",
    "body": [
      "Session::put(\"${1:key}\", ${2:value})"
    ],
    "description": "Put a value in session"
  },
  "Session Forget": {
    "prefix": "session:forget",
    "body": [
      "Session::forget(\"${1:key}\")"
    ],
    "description": "Forget a session key"
  },
  "Native Desktop Window App": {
    "prefix": "window",
    "body": [
      "var \\$win = Window::open(\"${1:Joss App}\", ${2:1120}, ${3:760})",
      "\\$win->setTheme(\"${4|dark,light,system|}\")",
      "\\$win->bind(\"${5:greet}\", func(string \\$name): string {",
      "\treturn \"Hola \" . \\$name",
      "})",
      "\\$win->setHtml(\"<h1>${1:Joss App}</h1>\")",
      "\\$win->run()"
    ],
    "description": "Create a native standalone desktop GUI app with Window + IPC"
  },
  "Model ORM Class": {
    "prefix": "model",
    "body": [
      "public class ${1:User} extends Model {",
      "\tprotected string \\$table = \"${2:users}\"",
      "\tprotected bool \\$softDeletes = ${3|true,false|}",
      "\tprotected array \\$fillable = [${4:\"name\", \"email\"}]",
      "\tprotected array \\$hidden = [${5:\"password\"}]",
      "\tprotected map \\$casts = {${6:\"active\": \"bool\"}}",
      "",
      "\t$0",
      "}"
    ],
    "description": "Define a Model ORM class extending Model"
  },
  "DateTime & DateInterval": {
    "prefix": "datetime",
    "body": [
      "var \\$now = DateTime::now()",
      "var \\$next = \\$now->add(DateInterval::days(${1:7}))",
      "print(\\$next->format(\"${2:Y-m-d H:i:s}\"))"
    ],
    "description": "Create and format DateTime with DateInterval"
  },
  "StreamReader Loop": {
    "prefix": "streamr",
    "body": [
      "var \\$reader = StreamReader::open(\"${1:file.txt}\")",
      "while (true) {",
      "\tstring|null \\$line = \\$reader->readLine()",
      "\t(\\$line == null) ? { break }",
      "\tprint(\\$line)",
      "}",
      "\\$reader->close()"
    ],
    "description": "Read a file line by line with StreamReader"
  },
  "StreamWriter": {
    "prefix": "streamw",
    "body": [
      "var \\$writer = StreamWriter::open(\"${1:output.txt}\", ${2|false,true|})",
      "\\$writer->writeLine(\"${3:Hello Joss}\")",
      "\\$writer->flush()",
      "\\$writer->close()"
    ],
    "description": "Write lines to a file with StreamWriter"
  },
  "Zip Extract": {
    "prefix": "zip",
    "body": [
      "bool \\$ok = Zip::extract(\"${1:archive.zip}\", \"${2:dest_dir}\")"
    ],
    "description": "Extract a ZIP archive safely (anti Zip-Slip + DEFLATE)"
  },
  "Record Declaration": {
    "prefix": "record",
    "body": [
      "public record ${1:Point}(${2:int \\$x, int \\$y})"
    ],
    "description": "Declare an immutable Joss record"
  }
}
