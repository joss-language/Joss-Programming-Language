{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JosSecurity",
  "scopeName": "source.joss",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.joss",
          "match": "//.*$"
        },
        {
          "name": "comment.block.joss",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.joss",
          "match": "\\b(if|else|while|do|foreach|as|return|break|continue|new|this|try|catch|throw|extends|async|await|match|default)\\b"
        },
        {
          "name": "keyword.other.joss",
          "match": "\\b(class|Init|public|private|protected|static|func|let|const|ref)\\b"
        },
        {
          "name": "keyword.operator.logical.joss",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "storage.type.joss",
          "match": "\\b(int|float|decimal|string|bool|array|map|channel|object|mixed|var|pointer|void)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.joss",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.joss",
              "match": "\\\\."
            },
            {
              "begin": "(\\$)(\\{)",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.joss"
                },
                "1": {
                  "name": "punctuation.definition.variable.joss"
                },
                "2": {
                  "name": "punctuation.section.embedded.begin.joss"
                }
              },
              "end": "(\\})",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.joss"
                },
                "1": {
                  "name": "punctuation.section.embedded.end.joss"
                }
              },
              "name": "meta.template.expression.joss",
              "patterns": [
                {
                  "name": "variable.other.joss",
                  "match": "\\$?[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#functions"
                },
                {
                  "include": "#strings"
                }
              ]
            },
            {
              "name": "variable.other.joss",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        },
        {
          "name": "string.quoted.single.joss",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.joss",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.joss",
          "match": "\\b\\d+(\\.\\d+)?m?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.joss",
          "match": "(===|!==|==|!=|<=>|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.joss",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.assignment.joss",
          "match": "(=>|\\+\\+|--|\\+=|-=|\\*=|/=|\\?\\?=|\\?\\?|=)"
        },
        {
          "name": "keyword.operator.range.joss",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.ternary.joss",
          "match": "(\\?|:)"
        },
        {
          "name": "keyword.operator.null-coalescing.joss",
          "match": "(\\?\\?)"
        },
        {
          "name": "keyword.operator.elvis.joss",
          "match": "(\\?:)"
        },
        {
          "name": "keyword.operator.logical.joss",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.joss",
          "match": "(<<|>>)"
        },
        {
          "name": "keyword.operator.pipe.joss",
          "match": "(\\|>)"
        },
        {
          "name": "keyword.operator.member.joss",
          "match": "(\\?-\\>|-\\>|\\.|::)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.joss",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.joss",
          "match": "\\b(print|echo|printf|env|isset|empty|len|count|async|await|toon_encode|toon_decode|toon_verify|json_encode|json_decode|json_verify|make_chan|close|send|recv|keys|values|redirect)\\b"
        },
        {
          "name": "support.function.joss",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.joss",
          "match": "\\b(Auth|GranDB|Stack|Queue|Main|Security|Server|Log|Task|Router|SmtpClient|View|Request|Response|Cron|Session|Redirect|RedirectResponse|WebResponse|WebSocket|Schema|Blueprint|Redis|Migration|Math|JSON|System|UserStorage|Markdown)\\b"
        },
        {
          "name": "support.class.joss",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.joss",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    }
  }
}
