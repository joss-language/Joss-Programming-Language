public func partition(array $arr, int $low, int $high): int {
    var $pivot = $arr[$high];
    var $i = $low - 1;
    var $j = $low;
    var $t = 0;
    while ($j < $high) {
        ($arr[$j] <= $pivot) ? {
            $i++;
            $t = $arr[$i];
            $arr[$i] = $arr[$j];
            $arr[$j] = $t;
        } : null;
        $j++;
    }
    var $t2 = $arr[$i + 1];
    $arr[$i + 1] = $arr[$high];
    $arr[$high] = $t2;
    return $i + 1;
}

public func sort(array $arr, int $low, int $high): void {
    while ($low < $high) {
        var $pi = partition($arr, $low, $high);
        sort($arr, $low, $pi - 1);
        $low = $pi + 1;
    }
}

var $N = 50000;
var $state = 123456789;
var $data = [];
var $idx = 0;
while ($idx < $N) {
    $state = ($state * 1664525 + 1013904223) % 2147483648;
    $data[] = $state;
    $idx = $idx + 1;
}

var $start = microtime(true);
sort($data, 0, $N - 1);
var $end = microtime(true);

var $v = 0;
while ($v < $N - 1) {
    ($data[$v] > $data[$v + 1]) ? {
        throw new Exception("Error: Array not sorted\n");
    } : null;
    $v = $v + 1;
}

var $elapsed_ms = ($end - $start) * 1000.0;
echo("Quicksort sorted " . $N . " elements in " . $elapsed_ms . " ms\n");
