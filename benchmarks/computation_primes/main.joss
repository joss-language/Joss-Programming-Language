// Benchmark A: Prime Sieve (Joss implementation)
public func countPrimes(int $limit): int {
    guard ($limit >= 2) : {
        return 0;
    }
    var $sieve = [];
    var $idx = 0;
    while ($idx <= $limit) {
        $sieve[] = 1;
        $idx = $idx + 1;
    }
    $sieve[0] = 0;
    $sieve[1] = 0;

    var $p = 2;
    while ($p * $p <= $limit) {
        ($sieve[$p] == 1) ? {
            var $i = $p * $p;
            while ($i <= $limit) {
                $sieve[$i] = 0;
                $i = $i + $p;
            }
        } : {}
        $p = $p + 1;
    }

    var $count = 0;
    var $k = 2;
    while ($k <= $limit) {
        ($sieve[$k] == 1) ? {
            $count = $count + 1;
        } : {}
        $k = $k + 1;
    }
    return $count;
}

var $limit = 1000000;
var $start = microtime(true);
var $count = countPrimes($limit);
var $end = microtime(true);
var $ms = ($end - $start) * 1000.0;

print("LIMIT=" . $limit . " COUNT=" . $count . " TIME_MS=" . $ms . "\n");
