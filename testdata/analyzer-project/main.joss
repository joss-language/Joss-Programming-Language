public func total(int $base, int $extra = 1): int {
    return $base + $extra
}

public func factorial(int $value): int {
    ($value <= 1) ? {
        return 1
    } : {
        return $value * factorial($value - 1)
    }
}

public func optionalTotal(bool $available): int? {
    $available ? {
        return total(2, 3)
    } : {
        return null
    }
}

public class Main {
    Init main() {
        var $value = total(2, 3)
        echo $value
        echo factorial(5)
        echo optionalTotal(true)
    }
}
